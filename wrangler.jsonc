{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revrebel-like-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-21",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revrebel-like-api-db"
      // Run `npm run db:create`, then paste the returned database_id here:
      // "database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
    }
  ]
}
